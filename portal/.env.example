# Django settings
SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Required when serving over HTTPS (admin forms otherwise get CSRF errors):
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# --- Cloudinary (Media Storage) ---
# OPTIONAL: if all three are empty, uploads are stored on disk (MEDIA_ROOT).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Database. SQLite for dev; MySQL for the Ubuntu server, e.g.:
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/portal_pec
DATABASE_URL=sqlite:///db.sqlite3

# Security. In production settings these default to True/1 year HSTS;
# set them to False ONLY when deploying without HTTPS (no domain/TLS yet).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# NOTE: DJANGO_SETTINGS_MODULE cannot be set here — the .env file is read
# *after* Django has already chosen its settings module. Set it in the shell
# (export DJANGO_SETTINGS_MODULE=config.settings.production) or in the
# systemd unit instead.
